* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
# Keep exported configuration bytes exact across clean clones.
*.ini -text
*.uproject -text
*.uplugin -text

*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
